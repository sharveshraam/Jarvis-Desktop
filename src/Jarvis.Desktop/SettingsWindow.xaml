<Window x:Class="Jarvis.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS Settings" Width="440" Height="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#151A21" Foreground="#F2F5F8" FontFamily="Segoe UI">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Gemini connection" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="Cloud chat sends your prompt and recent conversation to Google Gemini. The key is protected for your Windows account." TextWrapping="Wrap" Foreground="#A0AAB7" Margin="0,8,0,14"/>
    <StackPanel Grid.Row="2">
      <TextBlock Text="API key" Margin="0,0,0,6"/>
      <PasswordBox x:Name="ApiKeyBox" Background="#222A34" Foreground="#F2F5F8" BorderBrush="#35404D" Padding="8"/>
      <TextBlock Text="A saved key is protected by Windows. Leave blank to keep it; a new key replaces it. Keys are never committed." FontSize="11" Foreground="#82909F" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0" Background="#252E39" Foreground="#E5E9EF" BorderThickness="0"/>
      <Button Content="Save key" Click="Save_Click" Padding="16,8" Background="#43C8B7" Foreground="#0D1519" BorderThickness="0" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
