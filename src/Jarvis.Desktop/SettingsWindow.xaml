<Window x:Class="Jarvis.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS Settings" Width="540" Height="620" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" MinWidth="480" MinHeight="540" Background="#151A21" Foreground="#F2F5F8" FontFamily="Segoe UI">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Personalization and connection" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="Your profile is saved locally. When you use cloud chat, the profile and recent conversation are sent to Google Gemini along with your prompt." TextWrapping="Wrap" Foreground="#A0AAB7" Margin="0,8,0,14"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="Personal profile" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="Name" Margin="0,0,0,5"/>
        <TextBox x:Name="ProfileNameBox" MaxLength="100" Background="#222A34" Foreground="#F2F5F8" BorderBrush="#35404D" Padding="8"/>
        <TextBlock Text="Background and response preferences" Margin="0,12,0,5"/>
        <TextBox x:Name="ProfileContextBox" Height="145" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#222A34" Foreground="#F2F5F8" BorderBrush="#35404D" Padding="8"/>
        <TextBlock Text="Treat this as editable guidance; remove anything you do not want included in cloud chats." FontSize="11" Foreground="#82909F" Margin="0,5,0,18"/>
        <TextBlock Text="Global shortcut" Margin="0,0,0,5"/>
        <TextBox x:Name="GlobalShortcutBox" MaxLength="50" Background="#222A34" Foreground="#F2F5F8" BorderBrush="#35404D" Padding="8" ToolTip="Example: Ctrl+Shift+F12"/>
        <CheckBox x:Name="RunAtStartupCheckBox" Content="Run JARVIS when I sign in to Windows" Margin="0,10,0,18" Foreground="#F2F5F8"/>
        <Separator Background="#35404D" Margin="0,0,0,16"/>
        <TextBlock Text="Gemini connection" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="API key" Margin="0,0,0,6"/>
        <PasswordBox x:Name="ApiKeyBox" Background="#222A34" Foreground="#F2F5F8" BorderBrush="#35404D" Padding="8"/>
        <TextBlock Text="A saved key is protected by Windows. Leave blank to keep it; a new key replaces it. Keys are never committed." FontSize="11" Foreground="#82909F" Margin="0,7,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0" Background="#252E39" Foreground="#E5E9EF" BorderThickness="0"/>
      <Button Content="Save settings" Click="Save_Click" Padding="16,8" Background="#43C8B7" Foreground="#0D1519" BorderThickness="0" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
