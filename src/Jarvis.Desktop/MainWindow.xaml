<Window x:Class="Jarvis.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Jarvis.Core;assembly=Jarvis.Core"
        xmlns:local="clr-namespace:Jarvis.Desktop"
        Title="JARVIS" Width="520" Height="720" MinWidth="420" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#11151B" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
  <Window.Resources>
    <local:MessageBrushConverter x:Key="MessageBrushConverter" />
    <local:MessageAlignmentConverter x:Key="MessageAlignmentConverter" />
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="2,0,2,14">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
        <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0"/>
        <TextBlock Text="JARVIS" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="  PERSONAL ASSISTANT" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="9,2,0,0"/>
      </StackPanel>
      <Button Content="⚙" DockPanel.Dock="Right" Click="Settings_Click" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0" FontSize="18" Padding="8,0" ToolTip="Settings"/>
    </DockPanel>
    <Border Grid.Row="1" Background="#1B222B" CornerRadius="9" Padding="10,4" Margin="0,0,0,12">
      <DockPanel>
        <TextBlock Text="MODE" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
        <ComboBox SelectedValue="{Binding Mode}" SelectedValuePath="Tag" Background="#252E39" Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="6,4">
          <ComboBoxItem Content="Personal" Tag="{x:Static core:JarvisMode.Personal}"/>
          <ComboBoxItem Content="Study" Tag="{x:Static core:JarvisMode.Study}"/>
          <ComboBoxItem Content="Development" Tag="{x:Static core:JarvisMode.Development}"/>
          <ComboBoxItem Content="Research" Tag="{x:Static core:JarvisMode.Research}"/>
          <ComboBoxItem Content="Focus" Tag="{x:Static core:JarvisMode.Focus}"/>
          <ComboBoxItem Content="System" Tag="{x:Static core:JarvisMode.System}"/>
          <ComboBoxItem Content="Creator" Tag="{x:Static core:JarvisMode.Creator}"/>
        </ComboBox>
        <TextBlock Text="LOCAL FIRST" FontSize="9" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
      </DockPanel>
    </Border>
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12">
      <Grid>
        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{Binding Role, Converter={StaticResource MessageBrushConverter}}" CornerRadius="11" Padding="13,10" Margin="2,4,2,7" HorizontalAlignment="{Binding Role, Converter={StaticResource MessageAlignmentConverter}}" MaxWidth="420">
                  <StackPanel>
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" LineHeight="20"/>
                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}}" FontSize="9" Foreground="#8190A2" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="What can I help you with?" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#DCE5EB"/>
          <TextBlock Text="Try a quick local command or ask Gemini a question." FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <DockPanel Margin="2,0,2,7" LastChildFill="False">
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        <Button Content="Stop" Command="{Binding CancelCommand}" DockPanel.Dock="Right" Background="Transparent" Foreground="#E7A7A7" BorderThickness="0" FontSize="11" Padding="5,0"/>
      </DockPanel>
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="10,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="InputBox" Grid.Column="0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="3,8" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" KeyDown="Input_KeyDown" ToolTip="Type a message. Enter sends; Shift+Enter adds a line."/>
          <Button Grid.Column="1" Content="↑" Command="{Binding SendCommand}" Background="{StaticResource AccentBrush}" Foreground="#0D1519" FontSize="18" FontWeight="Bold" BorderThickness="0" Width="38" Height="38" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
        </Grid>
      </Border>
      <TextBlock Text="Local commands: ‘open Notepad’, ‘what time is it?’, ‘calculate 12 * 4’. Other messages go to Gemini." FontSize="10" Foreground="#778391" Margin="4,7,4,0"/>
    </StackPanel>
  </Grid>
</Window>
